generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-billing"
}

datasource db {
  provider = "postgresql"
  url      = env("BILLING_DATABASE_URL")
}

model ServiceUsage {
  id              String       @id @default(uuid()) @db.Uuid
  billingPeriodId String?      @map("billing_period_id") @db.Uuid
  startReadingId  String       @map("start_reading_id") @db.Uuid
  endReadingId    String       @map("end_reading_id") @db.Uuid
  createdAt       DateTime     @map("created_at")
  endReading      MeterReading @relation("UsageEndReading", fields: [endReadingId], references: [id])
  startReading    MeterReading @relation("UsageStartReading", fields: [startReadingId], references: [id])

  @@index([billingPeriodId])
  @@index([startReadingId])
  @@index([endReadingId])
  @@map("service_usage")
}

model Meter {
  id         String         @id @default(uuid()) @db.Uuid
  providerId String         @map("provider_id") @db.Uuid
  serviceId  String         @map("service") @db.Uuid
  name       String
  unit       String
  status     MeterStatus
  createdAt  DateTime       @map("created_at")
  updatedAt  DateTime       @map("updated_at")
  readings   MeterReading[]

  @@index([providerId])
  @@index([serviceId])
  @@map("meter")
}

model MeterReading {
  id          String         @id @default(uuid()) @db.Uuid
  roomId      String?        @map("room_id") @db.Uuid
  contractId  String?        @map("contract_id") @db.Uuid
  meterId     String         @map("meter_id") @db.Uuid
  recordedBy  String         @map("recorded_by") @db.Uuid
  value       Decimal        @db.Decimal(18, 2)
  imgUrl      String?        @map("img_url")
  source      ReadingSource
  status      ReadingStatus  @default(VALID)
  createdAt   DateTime       @map("created_at")
  updatedAt   DateTime       @map("updated_at")
  meter       Meter          @relation(fields: [meterId], references: [id])
  usagesEnd   ServiceUsage[] @relation("UsageEndReading")
  usagesStart ServiceUsage[] @relation("UsageStartReading")

  @@index([meterId, createdAt])
  @@index([roomId])
  @@index([contractId])
  @@index([recordedBy])
  @@map("meter_reading")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique @map("invoice_number")
  customerId      String?       @map("customer_id") @db.Uuid
  contractId      String?       @map("contract_id") @db.Uuid
  billingPeriodId String?       @map("billing_period_id") @db.Uuid
  providerId      String        @map("provider_id") @db.Uuid
  total           Decimal       @db.Decimal(18, 2)
  status          InvoiceStatus
  createdAt       DateTime      @map("created_at")
  updatedAt       DateTime      @map("updated_at")
  items           InvoiceItem[]
  ledgerEntries   Ledger[]
  payments        Payment[]

  @@index([customerId])
  @@index([contractId])
  @@index([billingPeriodId])
  @@index([providerId])
  @@index([providerId, status])
  @@index([status])
  @@map("invoice")
}

model InvoiceItem {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  servicePriceId String?  @map("service_price_id") @db.Uuid
  quantity       Decimal  @db.Decimal(18, 2)
  unit           String
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @map("created_at")
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([servicePriceId])
  @@map("invoice_item")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceId     String        @map("invoice_id") @db.Uuid
  paymentMethod PaymentMethod @map("payment_method")
  paymentLinkId String?       @unique @map("payment_link_id")
  status        PaymentStatus
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @map("created_at")
  qrCode        String?       @map("qr_code")
  checkOutUrl   String?       @map("check_out_url")
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payment")
}

model PayoutBatch {
  id            String            @id @default(uuid()) @db.Uuid
  batchId       String            @map("batch_id")
  status        PayoutBatchStatus
  createdAt     DateTime          @map("created_at")
  ledgerEntries Ledger[]

  @@map("payout_batch")
}

model Ledger {
  id                    String       @id @default(uuid()) @db.Uuid
  providerId            String       @map("provider_id") @db.Uuid
  invoiceId             String?      @map("invoice_id") @db.Uuid
  payoutBatchId         String?      @map("payout_batch_id") @db.Uuid
  type                  LedgerType
  amount                Decimal      @db.Decimal(18, 2)
  currency              String       @default("VND")
  status                LedgerStatus
  referenceId           String       @unique @map("reference_id")
  idempotencyKey        String?      @unique @map("idempotency_key")
  externalTransactionId String?      @unique @map("external_transaction_id")
  errorMessage          String?      @map("error_message")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @default(now()) @updatedAt @map("updated_at")
  completedAt           DateTime?    @map("completed_at")
  invoice               Invoice?     @relation(fields: [invoiceId], references: [id])
  payoutBatch           PayoutBatch? @relation(fields: [payoutBatchId], references: [id])

  @@index([providerId, type, status])
  @@index([providerId, createdAt])
  @@index([invoiceId])
  @@index([payoutBatchId])
  @@map("ledger")
}

enum MeterStatus {
  ACTIVE
  INACTIVE
}

enum ReadingSource {
  MANUAL
  IMAGE
  EXCEL_IMPORT
}

enum ReadingStatus {
  VALID
  VOID
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PayoutBatchStatus {
  DRAFTING
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  SCHEDULED
  PROCESSING
  FAILED
  PARTIAL_COMPLETED
  COMPLETED
}

enum LedgerType {
  INCOME
  PAYOUT
  REFUND
}

enum LedgerStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  UNKNOWN
  CANCELLED
}
