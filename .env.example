# ==============================================================================
# SERVICEHUB BACKEND - GLOBAL ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================

# Node Environment & JWT Secret Key
NODE_ENV=development
JWT_SECRET="servicehub_super_secret_jwt_key_2026"

# ==============================================================================
# EXTERNAL SERVICES CONFIGURATION
# ==============================================================================

# Frontend URL (For CORS & Redirects)
FRONTEND_URL="http://localhost:5173"

# Upstash Redis Connection (TLS required, rediss://)
# Used as the Message Broker for internal microservice communication
REDIS_URL="rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_ENDPOINT.upstash.io:6379"

# Cloudinary (Image & Document Storage)
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ==============================================================================
# MICROSERVICES CONFIGURATION
# ==============================================================================
# Note: Internal microservices (Identity, Provider, etc.) communicate exclusively
# via Redis and DO NOT expose HTTP ports. Only API Gateway is exposed to the outside.

# ------------------------------------------------------------------------------
# 1. API GATEWAY (Port: 3000)
# ------------------------------------------------------------------------------
PORT_API_GATEWAY=3000

# ------------------------------------------------------------------------------
# 2. IDENTITY & eKYC SERVICE
# ------------------------------------------------------------------------------
IDENTITY_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-withered-hat-az648vtv-pooler.c-3.ap-southeast-1.aws.neon.tech/identity_db?sslmode=require"

# ------------------------------------------------------------------------------
# 3. PROVIDER SERVICE
# ------------------------------------------------------------------------------
PROVIDER_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-withered-hat-az648vtv-pooler.c-3.ap-southeast-1.aws.neon.tech/provider_db?sslmode=require"

# ------------------------------------------------------------------------------
# 4. CUSTOMER SERVICE
# ------------------------------------------------------------------------------
CUSTOMER_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-withered-hat-az648vtv-pooler.c-3.ap-southeast-1.aws.neon.tech/customer_db?sslmode=require"

# ------------------------------------------------------------------------------
# 5. PROPERTY MANAGEMENT SERVICE
# ------------------------------------------------------------------------------
PROPERTY_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-withered-hat-az648vtv-pooler.c-3.ap-southeast-1.aws.neon.tech/property_db?sslmode=require"

# ------------------------------------------------------------------------------
# 6. SERVICE CATALOG SERVICE
# ------------------------------------------------------------------------------
CATALOG_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-withered-hat-az648vtv-pooler.c-3.ap-southeast-1.aws.neon.tech/catalog_db?sslmode=require"

# ------------------------------------------------------------------------------
# 7. CONTRACT MANAGEMENT SERVICE
# ------------------------------------------------------------------------------
CONTRACT_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-withered-hat-az648vtv-pooler.c-3.ap-southeast-1.aws.neon.tech/contract_db?sslmode=require"

# ------------------------------------------------------------------------------
# 8. DIGITAL SIGNATURE SERVICE
# ------------------------------------------------------------------------------
SIGNATURE_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-withered-hat-az648vtv-pooler.c-3.ap-southeast-1.aws.neon.tech/signature_db?sslmode=require"

# ------------------------------------------------------------------------------
# 9. BILLING & PAYMENT SERVICE
# ------------------------------------------------------------------------------
BILLING_DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-withered-hat-az648vtv-pooler.c-3.ap-southeast-1.aws.neon.tech/billing_db?sslmode=require"

# ------------------------------------------------------------------------------
# 10. NOTIFICATION SERVICE
# ------------------------------------------------------------------------------
