generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-billing"
}

datasource db {
  provider = "postgresql"
  url      = env("BILLING_DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  contractId         String?       @map("contract_id") @db.Uuid
  paymentLinkId      String?       @unique @map("payment_link_id") @db.VarChar(100)
  billingPeriodStart DateTime?     @map("billing_period_start") @db.Date
  billingPeriodEnd   DateTime?     @map("billing_period_end") @db.Date
  dueDate            DateTime?     @map("due_date") @db.Date
  totalAmount        Decimal?      @map("total_amount") @db.Decimal(18, 2)
  status             InvoiceStatus @default(DRAFT)
  createdAt          DateTime      @default(now()) @map("created_at")

  items    InvoiceItem[]
  payments Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  serviceId String?  @map("service_id") @db.Uuid
  quantity  Decimal? @db.Decimal(18, 2)
  amount    Decimal? @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  paymentLinkId String?       @unique @map("payment_link_id") @db.VarChar(100)
  invoiceId     String        @map("invoice_id") @db.Uuid
  paymentMethod String?       @map("payment_method") @db.VarChar(50)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?     @map("paid_at") @db.Timestamp(6)
  createdAt     DateTime      @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}
