generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-signature"
}

datasource db {
  provider = "postgresql"
  url      = env("SIGNATURE_DATABASE_URL")
}

model GnupgKey {
  id                  String              @id @default(uuid()) @db.Uuid
  identityId          String              @map("identity_id") @db.Uuid
  keyId               String              @map("key_id")
  fingerprint         String              @unique
  publicKey           String              @map("public_key")
  encryptedPrivateKey String
  encryptionSalt      String
  encryptionIv        String
  encryptionAuthTag   String
  encryptionVersion   Int                 @default(1)
  algorithm           String
  status              GnupgKeyStatus
  createdAt           DateTime            @default(now()) @map("created_at")
  expiresAt           DateTime?           @map("expires_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  signatures          ContractSignature[]

  @@map("gnupg_keys")
}

model ContractSignature {
  id             String   @id @default(uuid()) @db.Uuid
  contractFileId String   @map("contract_file_id") @db.Uuid
  gnupgKeyId     String   @map("gnupg_key_id") @db.Uuid
  signatureFile  String   @map("signature_file")
  signatureHash  String   @map("signature_hash")
  signedAt       DateTime @map("signed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  gnupgKey       GnupgKey @relation(fields: [gnupgKeyId], references: [id])

  @@index([contractFileId])
  @@index([gnupgKeyId])
  @@map("contract_signatures")
}

enum GnupgKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}
