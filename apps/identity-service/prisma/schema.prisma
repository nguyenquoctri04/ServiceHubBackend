generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-identity"
}

datasource db {
  provider = "postgresql"
  url      = env("IDENTITY_DATABASE_URL")
}

enum IdentityStatus {
  ACTIVE
  INACTIVE
}

enum BusinessType {
  INDIVIDUAL
  HOUSEHOLD
  COMPANY
}

enum ProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLE
}

enum ProviderType {
  PROPERTY_MANAGER
  EXTERNAL_SERVICE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LegalDocumentType {
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  OTHER
}

model Identity {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique
  phone          String
  passwordHash   String         @map("password_hash")
  roleId         String         @map("role_id") @db.Uuid
  status         IdentityStatus
  isEkycVerified Boolean        @default(false) @map("is_ekyc_verified")
  createdAt      DateTime       @map("created_at")
  updatedAt      DateTime       @map("updated_at")

  role              Role                    @relation(fields: [roleId], references: [id])
  verifications     IdentityVerification[]
  providers         Provider[]
  verifiedDocuments ProviderLegalDocument[] @relation("DocumentVerifiedBy")

  @@index([roleId])
  @@map("identity")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @map("created_at")
  updatedAt   DateTime         @map("updated_at")

  identities  Identity[]
  permissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime         @map("created_at")

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model IdentityVerification {
  id                String             @id @default(uuid()) @db.Uuid
  identityId        String             @map("identity_id") @db.Uuid
  provider          String
  referenceId       String?            @map("reference_id")
  verificationLevel String?            @map("verification_level")
  status            VerificationStatus @default(PENDING) @map("status")
  faceSimilarity    Decimal?           @map("face_similarity") @db.Decimal(5, 2)
  livenessScore     Decimal?           @map("liveness_score") @db.Decimal(5, 2)
  providerResponse  Json?              @map("provider_response")
  failureReason     String?            @map("failure_reason")
  verifiedAt        DateTime?          @map("verified_at")
  expiredAt         DateTime?          @map("expired_at")
  createdAt         DateTime           @map("created_at")

  identity  Identity           @relation(fields: [identityId], references: [id])
  documents IdentityDocument[]

  @@index([identityId])
  @@index([referenceId])
  @@map("identity_verification")
}

model IdentityDocument {
  id               String    @id @default(uuid()) @db.Uuid
  verificationId   String    @map("verification_id") @db.Uuid
  documentType     String?   @map("document_type")
  documentNumber   String?   @map("document_number")
  fullName         String?   @map("full_name")
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           String?
  nationality      String?
  placeOfOrigin    String?   @map("place_of_origin")
  placeOfResidence String?   @map("place_of_residence")
  issueDate        DateTime? @map("issue_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  issuingAuthority String?   @map("issuing_authority")
  frontImageUrl    String?   @map("front_image_url")
  backImageUrl     String?   @map("back_image_url")
  selfieImageUrl   String?   @map("selfie_image_url")
  frontImageHash   String?   @map("front_image_hash")
  backImageHash    String?   @map("back_image_hash")
  ocrRawData       Json?     @map("ocr_raw_data")
  createdAt        DateTime  @map("created_at")

  verification IdentityVerification @relation(fields: [verificationId], references: [id])

  @@index([verificationId])
  @@map("identity_document")
}

model Provider {
  id                     String         @id @default(uuid()) @db.Uuid
  identityId             String         @map("identity_id") @db.Uuid
  providerName           String         @map("provider_name")
  logoUrl                String?        @map("logo_url")
  bannerUrl              String?        @map("banner_url")
  numberCard             String?        @map("number_card")
  nameBank               String?        @map("name_bank")
  description            String?
  phone                  String?
  email                  String?
  website                String?
  address                String?
  companyName            String?        @map("company_name")
  taxCode                String?        @map("tax_code")
  businessLicenseNumber  String?        @map("business_license_number")
  representativeName     String?        @map("representative_name")
  representativePosition String?        @map("representative_position")
  businessType            BusinessType   @map("business_type")
  status                  ProviderStatus
  providerType            ProviderType   @map("provider_type")
  createdAt               DateTime       @map("created_at")
  updatedAt               DateTime       @map("updated_at")

  identity       Identity                @relation(fields: [identityId], references: [id])
  legalDocuments ProviderLegalDocument[]

  @@index([identityId])
  @@map("provider")
}

model ProviderLegalDocument {
  id                 String             @id @default(uuid()) @db.Uuid
  providerId         String             @map("provider_id") @db.Uuid
  documentType       LegalDocumentType  @map("document_type")
  documentName       String?            @map("document_name")
  documentNumber     String?            @map("document_number")
  fileUrl            String?            @map("file_url")
  issueDate          DateTime?          @map("issue_date") @db.Date
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @map("verification_status")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at")
  note               String?
  createdAt          DateTime           @map("created_at")

  provider Provider  @relation(fields: [providerId], references: [id])
  verifier Identity? @relation("DocumentVerifiedBy", fields: [verifiedBy], references: [id])

  @@index([providerId])
  @@index([verifiedBy])
  @@map("provider_legal_document")
}
