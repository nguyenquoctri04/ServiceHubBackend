generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-property"
}

datasource db {
  provider = "postgresql"
  url      = env("PROPERTY_DATABASE_URL")
}

enum PropertyType {
  APARTMENT
  BOARDING_HOUSE
  DORMITORY
  WHOLE_HOUSE
  OTHER
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RoomStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

enum MeterType {
  ELECTRICITY
  WATER
  GAS
  OTHER
}

enum MeterReadingSource {
  MANUAL
  OCR
  EXCEL_IMPORT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RepairStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model Property {
  id           String         @id @default(uuid()) @db.Uuid
  providerId   String         @map("provider_id") @db.Uuid
  propertyName String         @map("property_name") @db.VarChar(255)
  propertyType PropertyType   @map("property_type")
  description  String?        @db.Text
  address      String?        @db.Text
  latitude     Decimal?       @db.Decimal(10, 8)
  longitude    Decimal?       @db.Decimal(11, 8)
  status       PropertyStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  deletedAt    DateTime?      @map("deleted_at")

  blocks    Block[]
  roomTypes RoomType[]
  rooms     Room[]

  @@map("properties")
}

model Block {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @map("property_id") @db.Uuid
  blockCode   String?   @map("block_code") @db.VarChar(50)
  blockName   String?   @map("block_name") @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floors   Floor[]

  @@map("blocks")
}

model Floor {
  id          String    @id @default(uuid()) @db.Uuid
  blockId     String    @map("block_id") @db.Uuid
  floorNumber Int?      @map("floor_number")
  floorName   String?   @map("floor_name") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  block Block  @relation(fields: [blockId], references: [id], onDelete: Cascade)
  rooms Room[]

  @@map("floors")
}

model RoomType {
  id           String    @id @default(uuid()) @db.Uuid
  propertyId   String    @map("property_id") @db.Uuid
  typeName     String?   @map("type_name") @db.VarChar(100)
  area         Decimal?  @db.Decimal(10, 2)
  maxOccupancy Int?      @map("max_occupancy")
  description  String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@map("room_types")
}

model Room {
  id          String     @id @default(uuid()) @db.Uuid
  propertyId  String     @map("property_id") @db.Uuid
  floorId     String?    @map("floor_id") @db.Uuid
  roomTypeId  String     @map("room_type_id") @db.Uuid
  roomNumber  String?    @map("room_number") @db.VarChar(50)
  area        Decimal?   @db.Decimal(10, 2)
  status      RoomStatus @default(AVAILABLE)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floor         Floor?          @relation(fields: [floorId], references: [id])
  roomType      RoomType        @relation(fields: [roomTypeId], references: [id])
  images        RoomImage[]
  meterReadings MeterReading[]

  @@map("rooms")
}

model RoomImage {
  id           String   @id @default(uuid()) @db.Uuid
  roomId       String   @map("room_id") @db.Uuid
  imageUrl     String?  @map("image_url") @db.Text
  displayOrder Int?     @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_images")
}

model RoomServiceAssignment {
  id         String           @id @default(uuid()) @db.Uuid
  contractId String?          @map("contract_id") @db.Uuid
  serviceId  String?          @map("service_id") @db.Uuid
  required   Boolean?         @default(false)
  status     AssignmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")

  @@map("room_service_assignments")
}

model MeterReading {
  id                String             @id @default(uuid()) @db.Uuid
  roomId            String             @map("room_id") @db.Uuid
  meterType         MeterType          @map("meter_type")
  contractId        String?            @map("contract_id") @db.Uuid
  previousMeterId   String?            @unique @map("previous_meter_id") @db.Uuid
  readingValue      Decimal?           @map("reading_value") @db.Decimal(18, 2)
  consumptionAmount Decimal?           @map("consumption_amount") @db.Decimal(18, 2)
  imageUrl          String?            @map("image_url") @db.Text
  source            MeterReadingSource @default(MANUAL)
  isLocked          Boolean            @default(false) @map("is_locked")
  billingPeriod     DateTime?          @map("billing_period") @db.Date
  recordedBy        String?            @map("recorded_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at")

  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  previousMeter MeterReading? @relation("MeterReadingHistory", fields: [previousMeterId], references: [id])
  nextMeter     MeterReading? @relation("MeterReadingHistory")

  @@unique([roomId, meterType, billingPeriod])
  @@map("meter_readings")
}

model RepairRequest {
  id          String       @id @default(uuid()) @db.Uuid
  contractId  String?      @map("contract_id") @db.Uuid
  description String?      @db.Text
  priority    Priority     @default(MEDIUM)
  status      RepairStatus @default(OPEN)
  requestedBy String?      @map("requested_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@map("repair_requests")
}
