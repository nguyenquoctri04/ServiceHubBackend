generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-provider"
}

datasource db {
  provider = "postgresql"
  url      = env("PROVIDER_DATABASE_URL")
}

enum ProviderStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LegalDocumentType {
  BUSINESS_LICENSE
  TAX_CERTIFICATE
  FIRE_SAFETY_CERTIFICATE
  OTHER
}

enum ProviderType {
  PROPERTY_MANAGER
  EXTERNAL_SERVICE
}

enum LinkStatus {
  ACTIVE
  INACTIVE
  REJECTED
}

model Provider {
  id                     String         @id @default(uuid()) @db.Uuid
  identityId             String         @map("identity_id") @db.Uuid
  providerType           ProviderType   @default(PROPERTY_MANAGER) @map("provider_type")
  providerCode           String         @unique @map("provider_code") @db.VarChar(50)
  providerName           String         @map("provider_name") @db.VarChar(255)
  numberCard             String?        @map("number_card") @db.VarChar(100)
  nameBank               String?        @map("name_bank") @db.VarChar(255)
  logoUrl                String?        @map("logo_url") @db.Text
  bannerUrl              String?        @map("banner_url") @db.Text
  description            String?        @db.Text
  phone                  String?        @db.VarChar(50)
  email                  String?        @db.VarChar(255)
  website                String?        @db.VarChar(255)
  address                String?        @db.Text
  latitude               Decimal?       @db.Decimal(10, 8)
  longitude              Decimal?       @db.Decimal(11, 8)
  companyName            String?        @map("company_name") @db.VarChar(255)
  taxCode                String?        @map("tax_code") @db.VarChar(100)
  businessLicenseNumber  String?        @map("business_license_number") @db.VarChar(100)
  representativeName     String?        @map("representative_name") @db.VarChar(255)
  representativePosition String?        @map("representative_position") @db.VarChar(100)
  status                 ProviderStatus @default(PENDING)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  deletedAt              DateTime?      @map("deleted_at")

  legalDocuments ProviderLegalDocument[]
  settings       ProviderSetting[]
  statistic      ProviderStatistic?
  propertyLinks  ProviderPropertyLink[]

  @@map("providers")
}

model ProviderPropertyLink {
  id                            String     @id @default(uuid()) @db.Uuid
  providerId                    String     @map("provider_id") @db.Uuid
  propertyId                    String     @map("property_id") @db.Uuid
  distanceKm                    Decimal?   @map("distance_km") @db.Decimal(10, 2)
  isDistanceWarningAcknowledged Boolean    @default(false) @map("is_distance_warning_acknowledged")
  status                        LinkStatus @default(ACTIVE)
  createdAt                     DateTime   @default(now()) @map("created_at")
  updatedAt                     DateTime   @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, propertyId])
  @@map("provider_property_links")
}

model ProviderLegalDocument {
  id                 String             @id @default(uuid()) @db.Uuid
  providerId         String             @map("provider_id") @db.Uuid
  documentType       LegalDocumentType  @map("document_type")
  documentName       String?            @map("document_name") @db.VarChar(255)
  documentNumber     String?            @map("document_number") @db.VarChar(100)
  fileUrl            String?            @map("file_url") @db.Text
  issueDate          DateTime?          @map("issue_date") @db.Date
  expiryDate         DateTime?          @map("expiry_date") @db.Date
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  verifiedBy         String?            @map("verified_by") @db.Uuid
  verifiedAt         DateTime?          @map("verified_at")
  note               String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_legal_documents")
}

model ProviderSetting {
  id           String   @id @default(uuid()) @db.Uuid
  providerId   String   @map("provider_id") @db.Uuid
  settingKey   String   @map("setting_key") @db.VarChar(100)
  settingValue String?  @map("setting_value") @db.Text
  description  String?  @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, settingKey])
  @@map("provider_settings")
}

model ProviderStatistic {
  providerId         String   @id @map("provider_id") @db.Uuid
  propertyCount      Int      @default(0) @map("property_count")
  customerCount      Int      @default(0) @map("customer_count")
  activeServiceCount Int      @default(0) @map("active_service_count")
  updatedAt          DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_statistics")
}
