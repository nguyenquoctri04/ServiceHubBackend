generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-audit"
}

datasource db {
  provider = "postgresql"
  url      = env("AUDIT_DATABASE_URL")
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CREATE_CONTRACT
  UPDATE_CONTRACT
  TERMINATE_CONTRACT
  SIGN_CONTRACT
  CREATE_INVOICE
  UPDATE_INVOICE
  PAY_INVOICE
  CREATE_PROVIDER
  UPDATE_PROVIDER
  CREATE_PROPERTY
  UPDATE_PROPERTY
  DELETE_PROPERTY
  CREATE_ROOM
  UPDATE_ROOM
  DELETE_ROOM
  SEND_NOTIFICATION
  OTHER
}

model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  serviceName String?     @map("service_name") @db.VarChar(100)
  action      AuditAction
  entityType  String?     @map("entity_type") @db.VarChar(100)
  entityId    String?     @map("entity_id") @db.Uuid
  oldData     Json?       @map("old_data")
  newData     Json?       @map("new_data")
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.Text
  description String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  @@map("audit_logs")
}
