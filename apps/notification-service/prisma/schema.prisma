generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-notification"
}

datasource db {
  provider = "postgresql"
  url      = env("NOTIFICATION_DATABASE_URL")
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationTemplateStatus {
  ACTIVE
  INACTIVE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model NotificationTemplate {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique

  title   String
  content String

  channel NotificationChannel
  status  NotificationTemplateStatus

  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  notifications Notification[]

  @@map("notification_template")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid

  // Cross-service reference -> identity-service
  userId     String  @map("user_id") @db.Uuid
  providerId String? @map("provider_id") @db.Uuid

  templateId String? @map("template_id") @db.Uuid

  title   String?
  content String?

  channel NotificationChannel
  status  NotificationStatus

  sendAt DateTime @map("send_at")

  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([userId])
  @@index([userId, providerId])
  @@index([templateId])
  @@index([status, sendAt])
  @@map("notification")
}
