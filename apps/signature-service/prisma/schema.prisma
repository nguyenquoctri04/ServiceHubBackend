generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-signature"
}

datasource db {
  provider = "postgresql"
  url      = env("SIGNATURE_DATABASE_URL")
}

enum SignatureStatus {
  PENDING
  SIGNED
  FAILED
  REJECTED
}

model GnupgKey {
  id         String   @id @default(uuid()) @db.Uuid
  identityId String?  @map("identity_id") @db.Uuid
  publicKey  String?  @map("public_key") @db.Text
  privateKey String?  @map("private_key") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  signatures ContractSignature[]

  @@map("gnupg_keys")
}

model ContractSignature {
  id         String          @id @default(uuid()) @db.Uuid
  contractId String?         @map("contract_id") @db.Uuid
  gnupgKeyId String?         @map("gnupg_key_id") @db.Uuid
  status     SignatureStatus @default(PENDING)
  createdAt  DateTime        @default(now()) @map("created_at")

  gnupgKey GnupgKey? @relation(fields: [gnupgKeyId], references: [id])

  @@map("contract_signatures")
}
