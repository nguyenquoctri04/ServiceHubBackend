// Prisma Schema for Identity & eKYC Service
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("IDENTITY_DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  identities      Identity[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Identity {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.Text
  roleId         String    @map("role_id") @db.Uuid
  status         String    @db.VarChar(50)
  isEkycVerified Boolean   @default(false) @map("is_ekyc_verified")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  role                   Role                    @relation(fields: [roleId], references: [id])
  identityVerifications IdentityVerification[]
  authenticationHistories AuthenticationHistory[]

  @@map("identities")
}

model IdentityVerification {
  id                String    @id @default(uuid()) @db.Uuid
  identityId        String    @map("identity_id") @db.Uuid
  provider          String    @db.VarChar(100)
  referenceId       String?   @map("reference_id") @db.VarChar(255)
  verificationLevel String?   @map("verification_level") @db.VarChar(50)
  faceSimilarity    Decimal?  @map("face_similarity") @db.Decimal(5, 2)
  livenessScore     Decimal?  @map("liveness_score") @db.Decimal(5, 2)
  providerResponse  Json?     @map("provider_response") @db.JsonB
  failureReason     String?   @map("failure_reason") @db.Text
  verifiedAt        DateTime? @map("verified_at")
  expiredAt         DateTime? @map("expired_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  identity          Identity           @relation(fields: [identityId], references: [id], onDelete: Cascade)
  identityDocuments IdentityDocument[]

  @@map("identity_verifications")
}

model IdentityDocument {
  id               String    @id @default(uuid()) @db.Uuid
  verificationId   String    @map("verification_id") @db.Uuid
  documentType     String?   @map("document_type") @db.VarChar(50)
  documentNumber   String?   @map("document_number") @db.VarChar(100)
  fullName         String?   @map("full_name") @db.VarChar(255)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  gender           String?   @db.VarChar(20)
  nationality      String?   @db.VarChar(100)
  issueDate        DateTime? @map("issue_date") @db.Date
  expiryDate       DateTime? @map("expiry_date") @db.Date
  issuingAuthority String?   @map("issuing_authority") @db.VarChar(255)
  frontImageUrl    String?   @map("front_image_url") @db.Text
  backImageUrl     String?   @map("back_image_url") @db.Text
  selfieImageUrl   String?   @map("selfie_image_url") @db.Text
  ocrRawData       Json?     @map("ocr_raw_data") @db.JsonB
  createdAt        DateTime  @default(now()) @map("created_at")

  verification IdentityVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@map("identity_documents")
}

model AuthenticationHistory {
  id            String   @id @default(uuid()) @db.Uuid
  identityId    String   @map("identity_id") @db.Uuid
  action        String?  @db.VarChar(50)
  status        String?  @db.VarChar(50)
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.Text
  deviceName    String?  @map("device_name") @db.VarChar(255)
  failureReason String?  @map("failure_reason") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@map("authentication_histories")
}
