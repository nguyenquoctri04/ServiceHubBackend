generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-catalog"
}

datasource db {
  provider = "postgresql"
  url      = env("CATALOG_DATABASE_URL")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  description String?
  name        String    @unique
  services    Service[]

  @@map("category")
}

model Service {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  description        String?
  status             ServiceStatus
  address            String
  latitude           Decimal              @db.Decimal(9, 6)
  longitude          Decimal              @map("longitude") @db.Decimal(10, 6)
  requiresPrepayment Boolean              @default(false) @map("requires_prepayment")
  requiresContract   Boolean              @default(true) @map("requires_contract")
  contractTemplateId String?              @map("contract_template_id") @db.Uuid
  providerId         String               @map("provider_id") @db.Uuid
  categoryId         String               @map("category_id") @db.Uuid
  billingRuleId      String               @map("billing_rule_id") @db.Uuid
  serviceType        ServiceType          @map("service_type")
  roomTypeId         String?              @map("room_type_id") @db.Uuid
  createdAt          DateTime             @map("created_at")
  updatedAt          DateTime             @map("updated_at")
  billingSchedules   BillingSchedule[]
  billingRule        ServiceBillingRule   @relation(fields: [billingRuleId], references: [id])
  category           Category             @relation(fields: [categoryId], references: [id])
  roomType           RoomType?            @relation(fields: [roomTypeId], references: [id])
  images             ServiceImage[]
  prices             ServicePrice[]
  requiredBy         ServiceRequirement[] @relation("AdditionalService")
  requirements       ServiceRequirement[] @relation("MainService")

  @@index([providerId])
  @@index([categoryId])
  @@index([billingRuleId])
  @@index([roomTypeId])
  @@map("service")
}

model ServiceBillingRule {
  id                   String              @id @default(uuid()) @db.Uuid
  calculationMethod    CalculationMethod   @map("calculation_method")
  billingFrequency     BillingFrequency    @map("billing_frequency")
  billingIntervalValue Int                 @default(1) @map("billing_interval_value")
  billingIntervalUnit  BillingIntervalUnit @map("billing_interval_unit")
  prorationMethod      ProrationMethod     @default(NONE) @map("proration_method")
  usageSource          Boolean             @default(false) @map("usage_source")
  createdAt            DateTime            @map("created_at")
  updatedAt            DateTime            @map("updated_at")
  services             Service[]

  @@map("service_billing_rule")
}

model BillingSchedule {
  id         String   @id @default(uuid()) @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  billingDay Int      @map("billing_day")
  dueDays    Int      @map("due_days")
  createdAt  DateTime @map("created_at")
  updatedAt  DateTime @map("updated_at")
  service    Service  @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
  @@map("billing_schedule")
}

model ServicePrice {
  id            String             @id @default(uuid()) @db.Uuid
  createdBy     String             @map("created_by") @db.Uuid
  serviceId     String             @map("service_id") @db.Uuid
  price         Decimal            @db.Decimal(18, 2)
  unit          String
  effectiveFrom DateTime           @map("effective_from") @db.Date
  effectiveTo   DateTime?          @map("effective_to") @db.Date
  createdAt     DateTime           @map("created_at")
  service       Service            @relation(fields: [serviceId], references: [id])
  tiers         ServicePriceTier[]

  @@index([serviceId])
  @@index([effectiveFrom, effectiveTo])
  @@map("service_price")
}

model ServiceRequirement {
  id                  String        @id @default(uuid()) @db.Uuid
  serviceId           String        @map("service_id") @db.Uuid
  additionalServiceId String        @map("additional_service_id") @db.Uuid
  status              ServiceStatus
  additionalService   Service       @relation("AdditionalService", fields: [additionalServiceId], references: [id])
  service             Service       @relation("MainService", fields: [serviceId], references: [id])

  @@unique([serviceId, additionalServiceId])
  @@index([additionalServiceId])
  @@map("service_requirement")
}

model ServicePriceTier {
  id             String       @id @default(uuid()) @db.Uuid
  servicePriceId String       @map("service_price_id") @db.Uuid
  fromValue      Decimal?     @map("from_value") @db.Decimal(18, 2)
  toValue        Decimal?     @map("to_value") @db.Decimal(18, 2)
  price          Decimal      @db.Decimal(18, 2)
  servicePrice   ServicePrice @relation(fields: [servicePriceId], references: [id])

  @@index([servicePriceId])
  @@map("service_price_tier")
}

model ServiceImage {
  id           String   @id @default(uuid()) @db.Uuid
  serviceId    String   @map("service_id") @db.Uuid
  imageUrl     String   @map("image_url")
  displayOrder Int      @map("display_order")
  createdAt    DateTime @map("created_at")
  service      Service  @relation(fields: [serviceId], references: [id])

  @@index([serviceId, displayOrder])
  @@map("service_image")
}

model Property {
  id           String         @id @default(uuid()) @db.Uuid
  providerId   String         @map("provider_id") @db.Uuid
  propertyName String         @map("property_name")
  description  String?
  address      String
  latitude     Decimal        @db.Decimal(9, 6)
  longitude    Decimal        @map("longitude") @db.Decimal(10, 6)
  status       PropertyStatus
  createdAt    DateTime       @map("created_at")
  updatedAt    DateTime       @map("updated_at")
  blocks       Block[]
  roomTypes    RoomType[]

  @@index([providerId])
  @@map("property")
}

model Block {
  id         String         @id @default(uuid()) @db.Uuid
  propertyId String         @map("property_id") @db.Uuid
  blockName  String         @map("block_name")
  status     PropertyStatus
  createdAt  DateTime       @map("created_at")
  updatedAt  DateTime       @map("updated_at")
  property   Property       @relation(fields: [propertyId], references: [id])
  floors     Floor[]

  @@index([propertyId])
  @@map("block")
}

model Floor {
  id        String         @id @default(uuid()) @db.Uuid
  blockId   String         @map("block_id") @db.Uuid
  floorName String         @map("floor_name")
  status    PropertyStatus
  createdAt DateTime       @map("created_at")
  updatedAt DateTime       @map("updated_at")
  block     Block          @relation(fields: [blockId], references: [id])
  rooms     Room[]

  @@index([blockId])
  @@map("floor")
}

model RoomType {
  id           String         @id @default(uuid()) @db.Uuid
  propertyId   String         @map("property_id") @db.Uuid
  typeName     String         @map("type_name")
  area         Decimal        @db.Decimal(10, 2)
  maxOccupancy Int            @map("max_occupancy")
  description  String?
  status       RoomTypeStatus
  createdAt    DateTime       @map("created_at")
  updatedAt    DateTime       @map("updated_at")
  rooms        Room[]
  property     Property       @relation(fields: [propertyId], references: [id])
  services     Service[]

  @@index([propertyId])
  @@map("room_type")
}

model Room {
  id         String     @id @default(uuid()) @db.Uuid
  roomTypeId String     @map("room_type_id") @db.Uuid
  floorId    String?    @map("floor_id") @db.Uuid
  roomNumber String     @map("room_number")
  status     RoomStatus
  revision   Int        @default(1)
  createdAt  DateTime   @map("created_at")
  updatedAt  DateTime   @map("updated_at")
  floor      Floor?     @relation(fields: [floorId], references: [id])
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id])

  @@index([roomTypeId])
  @@index([floorId])
  @@map("room")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum CalculationMethod {
  FIXED
  QUANTITY
  METERED
}

enum BillingFrequency {
  ONE_TIME
  RECURRING
}

enum BillingIntervalUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum ProrationMethod {
  NONE
  DAILY
}

enum ServiceType {
  NORMAL
  ADDITION
}

enum PropertyStatus {
  ACTIVE
  INACTIVE
}

enum RoomTypeStatus {
  ACTIVE
  INACTIVE
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

// =========================================================================
// RELIABILITY TABLES (Transactional Outbox & Idempotent Inbox)
// =========================================================================

/// Bảng Transactional Outbox lưu trữ các sự kiện nghiệp vụ phát sinh từ Catalog Service (VD: catalog.room_locked.v1).
model OutboxMessage {
  /// Khóa chính định danh duy nhất của sự kiện (UUID v4)
  id                String    @id @default(uuid()) @db.Uuid

  /// Phiên bản của chuẩn CloudEvents (mặc định "1.0")
  specVersion       String    @default("1.0") @map("spec_version") @db.VarChar(10)

  /// Tên loại sự kiện có phân cấp phiên bản
  eventType         String    @map("event_type") @db.VarChar(100)

  /// Tên dịch vụ phát sinh sự kiện (mặc định "servicehub.catalog")
  source            String    @default("servicehub.catalog") @db.VarChar(100)

  /// Khóa định danh của đối tượng chính (thường là roomId)
  subject           String    @db.VarChar(100)

  /// Khóa gom nhóm tuần tự (FIFO) nhằm đảm bảo các event của cùng một phòng không bị xử lý lộn xộn
  orderingKey       String    @map("ordering_key") @db.VarChar(100)

  /// Loại đối tượng nghiệp vụ (mặc định "ROOM")
  aggregateType     String    @default("ROOM") @map("aggregate_type") @db.VarChar(50)

  /// Khóa chính ID của đối tượng nghiệp vụ (roomId)
  aggregateId       String    @map("aggregate_id") @db.Uuid

  /// Phiên bản của phòng tại thời điểm phát sinh sự kiện
  aggregateRevision Int       @default(1) @map("aggregate_revision")

  /// Dữ liệu chi tiết của sự kiện dạng JSONB
  payload           Json      @db.JsonB

  /// Chữ ký HMAC của dòng dữ liệu nhằm chống Insider Threat
  rowSignature      String?   @map("row_signature") @db.VarChar(128)

  /// Trạng thái xử lý: PENDING, PUBLISHED, DEAD_LETTER, TAMPERED
  status            String    @default("PENDING") @db.VarChar(20)

  /// Số lần đã thử phát lại sự kiện qua Message Broker
  attemptCount      Int       @default(0) @map("attempt_count")

  /// Số lần thử lại tối đa trước khi đưa vào Dead Letter (mặc định 5 lần)
  maxAttempts       Int       @default(5) @map("max_attempts")

  /// Thời điểm kế tiếp cho phép worker quét và thử lại
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at")

  /// Mã lỗi gần nhất nếu việc phát tin thất bại
  lastErrorCode     String?   @map("last_error_code") @db.VarChar(100)

  /// Chi tiết thông điệp lỗi kỹ thuật
  lastErrorMessage  String?   @map("last_error_message") @db.Text

  /// Mã định danh truy vết phân tán xuyên suốt các microservice
  correlationId     String?   @map("correlation_id") @db.Uuid

  /// Thời điểm sự kiện thực tế phát sinh trong nghiệp vụ
  occurredAt        DateTime  @default(now()) @map("occurred_at")

  /// Thời điểm sự kiện đã được chuyển giao thành công sang Message Broker
  publishedAt       DateTime? @map("published_at")

  @@index([status, nextAttemptAt, occurredAt], name: "idx_outbox_polling")
  @@index([aggregateType, aggregateId], name: "idx_outbox_aggregate")
  @@unique([eventType, aggregateId, aggregateRevision], name: "uq_outbox_event_revision")
  @@map("outbox_message")
}

/// Bảng Idempotent Inbox dùng để khử trùng lặp sự kiện nhận được từ Contract Service (VD: contract.activated.v1, contract.cancelled.v1).
model InboxMessage {
  /// Tên định danh của Consumer tiếp nhận (VD: "catalog-contract-activated-consumer")
  consumerName      String    @map("consumer_name") @db.VarChar(100)

  /// Khóa định danh của sự kiện nhận được
  eventId           String    @map("event_id") @db.Uuid

  /// Tên loại sự kiện đã nhận
  eventType         String    @map("event_type") @db.VarChar(100)

  /// Tên dịch vụ nguồn phát sinh (VD: "servicehub.contract")
  producer          String    @db.VarChar(100)

  /// Khóa gom nhóm tuần tự nhận từ nguồn phát
  orderingKey       String?   @map("ordering_key") @db.VarChar(100)

  /// Mã băm SHA-256 của payload nhận được
  payloadHash       String?   @map("payload_hash") @db.VarChar(64)

  /// Trạng thái xử lý: PROCESSING, PROCESSED, FAILED
  status            String    @default("PROCESSED") @db.VarChar(20)

  /// Thời điểm Consumer nhận được tin nhắn từ Message Broker
  receivedAt        DateTime  @default(now()) @map("received_at")

  /// Thời điểm Consumer hoàn tất việc cập nhật nghiệp vụ
  processedAt       DateTime? @map("processed_at")

  @@id([consumerName, eventId])
  @@index([orderingKey])
  @@map("inbox_message")
}
