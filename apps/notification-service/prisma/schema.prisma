generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-notification"
}

datasource db {
  provider = "postgresql"
  url      = env("NOTIFICATION_DATABASE_URL")
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum NotificationTemplateStatus {
  ACTIVE
  INACTIVE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum NotificationKind {
  BROADCAST
  EVENT
}

enum NotificationTargetType {
  ALL
  ROLE
  USER
}

model NotificationTemplate {
  id        String                     @id @default(uuid()) @db.Uuid
  code      String                     @unique

  title     String
  content   String

  channel   NotificationChannel
  status    NotificationTemplateStatus

  createdAt DateTime                   @map("created_at")
  updatedAt DateTime                   @map("updated_at")

  notifications Notification[]

  @@map("notification_template")
}

model Notification {
  id         String               @id @default(uuid()) @db.Uuid

  // Cross-service reference -> identity-service
  userId     String               @map("user_id") @db.Uuid

  templateId String?              @map("template_id") @db.Uuid

  kind       NotificationKind     @default(EVENT)
  eventType  String?              @map("event_type")
  targetType NotificationTargetType? @map("target_type")
  actorId    String?              @map("actor_id") @db.Uuid
  createdBy  String?              @map("created_by") @db.Uuid
  entityType String?              @map("entity_type")
  entityId   String?              @map("entity_id")
  payload    Json?

  title      String?
  content    String?

  channel    NotificationChannel
  status     NotificationStatus

  sendAt     DateTime             @map("send_at")
  deliveredAt DateTime?           @map("delivered_at")
  readAt     DateTime?            @map("read_at")
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([userId])
  @@index([userId, status])
  @@index([kind, eventType])
  @@index([entityType, entityId])
  @@index([templateId])
  @@index([status, sendAt])
  @@map("notification")
}
