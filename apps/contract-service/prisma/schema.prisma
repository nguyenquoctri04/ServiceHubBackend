generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-contract"
}

datasource db {
  provider = "postgresql"
  url      = env("CONTRACT_DATABASE_URL")
}

model Contract {
  id               String            @id @default(uuid()) @db.Uuid
  contractNumber   String            @unique @map("contract_number")
  providerId       String            @map("provider_id") @db.Uuid
  roomId           String?           @map("room_id") @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  startDate        DateTime          @map("start_date") @db.Date
  endDate          DateTime?         @map("end_date") @db.Date
  status           ContractStatus
  revision         Int               @default(1)
  requireSignature Boolean           @default(false) @map("require_signature")
  signedAt         DateTime?         @map("signed_at")
  createdAt        DateTime          @map("created_at")
  updatedAt        DateTime          @map("updated_at")
  billingPeriods   BillingPeriod[]
  files            ContractFile[]
  services         ContractService[]
  terms            ContractTerm[]
  violationCases   ViolationCase[]

  @@index([providerId])
  @@index([customerId])
  @@index([roomId])
  @@index([status])
  @@index([providerId, status, customerId])
  @@map("contract")
}

model ContractService {
  id             String   @id @default(uuid()) @db.Uuid
  contractId     String   @map("contract_id") @db.Uuid
  servicePriceId String   @map("service_price_id") @db.Uuid
  quantity       Decimal? @db.Decimal(18, 2)
  createdAt      DateTime @map("created_at")
  contract       Contract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@index([servicePriceId])
  @@map("contract_service")
}

model ContractTemplate {
  id          String                  @id @default(uuid()) @db.Uuid
  providerId  String?                 @map("provider_id") @db.Uuid
  name        String?
  description String?
  content     Json?
  status      ContractTemplateStatus?
  createdAt   DateTime?               @map("created_at")
  updatedAt   DateTime?               @map("updated_at")

  @@index([providerId])
  @@map("contract_template")
}

model TemplateVariable {
  id        String @id @default(uuid()) @db.Uuid
  key       String
  label     String
  groupName String @map("group_name")

  @@unique([key, groupName])
  @@map("template_variable")
}

model ContractFile {
  id           String   @id @default(uuid()) @db.Uuid
  contractId   String   @map("contract_id") @db.Uuid
  pdfUrl       String   @map("pdf_url")
  hashContract String?  @map("hash_contract")
  contract     Contract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@map("contract_file")
}

model Term {
  id        String         @id @default(uuid()) @db.Uuid
  content   String
  status    TermStatus
  createdAt DateTime       @map("created_at")
  contracts ContractTerm[]

  @@map("term")
}

model ContractTerm {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  termId     String   @map("term_id") @db.Uuid
  createdAt  DateTime @map("created_at")
  contract   Contract @relation(fields: [contractId], references: [id])
  term       Term     @relation(fields: [termId], references: [id])

  @@unique([contractId, termId])
  @@map("contract_term")
}

model BillingPeriod {
  id          String   @id @default(uuid()) @db.Uuid
  contractId  String   @map("contract_id") @db.Uuid
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")
  contract    Contract @relation(fields: [contractId], references: [id])

  @@index([contractId, periodStart])
  @@map("billing_period")
}

model ViolationRule {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  description String?
  targetType  ViolationTargetType @map("target_type")
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @map("created_at")
  updatedAt   DateTime            @map("updated_at")
  cases       ViolationCase[]

  @@map("violation_rule")
}

model ViolationCase {
  id              String              @id @default(uuid()) @db.Uuid
  violationRuleId String              @map("violation_rule_id") @db.Uuid
  contractId      String              @map("contract_id") @db.Uuid
  providerId      String              @map("provider_id") @db.Uuid
  reportedBy      String              @map("reported_by") @db.Uuid
  serviceId       String?             @map("service_id") @db.Uuid
  status          ViolationCaseStatus
  description     String
  occurredAt      DateTime            @map("occurred_at")
  createdAt       DateTime            @map("created_at")
  updatedAt       DateTime            @map("updated_at")
  actions         ViolationAction[]
  appeals         ViolationAppeal[]
  contract        Contract            @relation(fields: [contractId], references: [id])
  violationRule   ViolationRule       @relation(fields: [violationRuleId], references: [id])
  evidence        ViolationEvidence[]

  @@index([violationRuleId])
  @@index([contractId])
  @@index([reportedBy])
  @@index([serviceId])
  @@index([providerId, status, createdAt])
  @@map("violation_case")
}

model ViolationEvidence {
  id              String        @id @default(uuid()) @db.Uuid
  violationCaseId String        @map("violation_case_id") @db.Uuid
  fileUrl         String        @map("file_url")
  violationCase   ViolationCase @relation(fields: [violationCaseId], references: [id])

  @@index([violationCaseId])
  @@map("violation_evidence")
}

model ViolationAction {
  id              String              @id @default(uuid()) @db.Uuid
  violationCaseId String              @map("violation_case_id") @db.Uuid
  performedBy     String              @map("performed_by") @db.Uuid
  actionType      ViolationActionType @map("action_type")
  reason          String?
  amount          Decimal?            @db.Decimal(18, 2)
  createdAt       DateTime            @map("created_at")
  restrictions    Restriction[]
  violationCase   ViolationCase       @relation(fields: [violationCaseId], references: [id])

  @@index([violationCaseId])
  @@index([performedBy])
  @@map("violation_action")
}

model Restriction {
  id                String               @id @default(uuid()) @db.Uuid
  violationActionId String               @map("violation_action_id") @db.Uuid
  providerId        String?              @map("provider_id") @db.Uuid
  customerId        String?              @map("customer_id") @db.Uuid
  serviceId         String?              @map("service_id") @db.Uuid
  scopeType         RestrictionScopeType @map("scope_type")
  reason            String
  startAt           DateTime             @map("start_at")
  endAt             DateTime?            @map("end_at")
  createdBy         String               @map("created_by") @db.Uuid
  isDeleted         Boolean              @default(false) @map("is_deleted")
  createdAt         DateTime             @map("created_at")
  updatedAt         DateTime             @map("updated_at")
  violationAction   ViolationAction      @relation(fields: [violationActionId], references: [id])

  @@index([providerId])
  @@index([customerId])
  @@index([serviceId])
  @@index([scopeType])
  @@map("restriction")
}

model ViolationAppeal {
  id              String        @id @default(uuid()) @db.Uuid
  violationCaseId String        @map("violation_case_id") @db.Uuid
  appellantId     String        @map("appellant_id") @db.Uuid
  reviewedBy      String?       @map("reviewed_by") @db.Uuid
  reason          String
  status          AppealStatus
  reviewedAt      DateTime?     @map("reviewed_at")
  resolutionNote  String?       @map("resolution_note")
  createdAt       DateTime      @map("created_at")
  updatedAt       DateTime      @map("updated_at")
  violationCase   ViolationCase @relation(fields: [violationCaseId], references: [id])

  @@index([violationCaseId])
  @@index([appellantId])
  @@map("violation_appeal")
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
  PENDING_PAYMENT
}

enum ContractTemplateStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum TermStatus {
  ACTIVE
  INACTIVE
}

enum ViolationTargetType {
  CUSTOMER
  PROVIDER
  BOTH
}

enum ViolationCaseStatus {
  REPORTED
  REJECTED
  RESOLVED
  CANCELLED
}

enum ViolationActionType {
  WARNING
  REQUEST_CORRECTION
  FINE
  RESTRICT
  TERMINATE_CONTRACT
  NO_ACTION
}

enum RestrictionScopeType {
  PLATFORM
  PROVIDER
  SERVICE
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// =========================================================================
// RELIABILITY TABLES (Transactional Outbox, Inbox, Idempotency)
// =========================================================================

/// Bảng Transactional Outbox lưu trữ các sự kiện nghiệp vụ phát sinh từ Contract Service.
/// Đảm bảo nguyên tắc: Mutation nghiệp vụ và Lưu sự kiện nằm trong cùng một Local Transaction.
model OutboxMessage {
  /// Khóa chính định danh duy nhất của sự kiện (UUID v4)
  id                String    @id @default(uuid()) @db.Uuid

  /// Phiên bản của chuẩn CloudEvents (mặc định "1.0")
  specVersion       String    @default("1.0") @map("spec_version") @db.VarChar(10)

  /// Tên loại sự kiện có phân cấp phiên bản (VD: "contract.sent_for_signing.v1", "contract.activated.v1")
  eventType         String    @map("event_type") @db.VarChar(100)

  /// Tên dịch vụ phát sinh sự kiện (mặc định "servicehub.contract")
  source            String    @default("servicehub.contract") @db.VarChar(100)

  /// Khóa định danh của đối tượng chính (thường là contractId)
  subject           String    @db.VarChar(100)

  /// Khóa gom nhóm tuần tự (FIFO) nhằm đảm bảo các event của cùng một hợp đồng không bị xử lý lộn xộn
  orderingKey       String    @map("ordering_key") @db.VarChar(100)

  /// Loại đối tượng nghiệp vụ (mặc định "CONTRACT")
  aggregateType     String    @default("CONTRACT") @map("aggregate_type") @db.VarChar(50)

  /// Khóa chính ID của đối tượng nghiệp vụ (contractId)
  aggregateId       String    @map("aggregate_id") @db.Uuid

  /// Phiên bản của hợp đồng tại thời điểm phát sinh sự kiện (phục vụ Optimistic Locking)
  aggregateRevision Int       @default(1) @map("aggregate_revision")

  /// Dữ liệu chi tiết của sự kiện dạng JSONB (chỉ chứa minimal facts, không chứa secret/PII)
  payload           Json      @db.JsonB

  /// Chữ ký HMAC của dòng dữ liệu nhằm chống Insider Threat (Dev/DBA chèn bản ghi giả mạo qua SQL)
  rowSignature      String?   @map("row_signature") @db.VarChar(128)

  /// Trạng thái xử lý: PENDING (chờ phát), PUBLISHED (đã gửi), DEAD_LETTER (lỗi quá 5 lần), TAMPERED (bị sửa trộm)
  status            String    @default("PENDING") @db.VarChar(20)

  /// Số lần đã thử phát lại sự kiện qua Message Broker
  attemptCount      Int       @default(0) @map("attempt_count")

  /// Số lần thử lại tối đa trước khi đưa vào Dead Letter (mặc định 5 lần)
  maxAttempts       Int       @default(5) @map("max_attempts")

  /// Thời điểm kế tiếp cho phép worker quét và thử lại (tính theo Exponential Backoff)
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at")

  /// Mã lỗi gần nhất nếu việc phát tin thất bại
  lastErrorCode     String?   @map("last_error_code") @db.VarChar(100)

  /// Chi tiết thông điệp lỗi kỹ thuật để lập trình viên điều tra
  lastErrorMessage  String?   @map("last_error_message") @db.Text

  /// Mã định danh truy vết phân tán xuyên suốt các microservice (Distributed Tracing ID)
  correlationId     String?   @map("correlation_id") @db.Uuid

  /// Thời điểm sự kiện thực tế phát sinh trong nghiệp vụ
  occurredAt        DateTime  @default(now()) @map("occurred_at")

  /// Thời điểm sự kiện đã được chuyển giao thành công sang Message Broker
  publishedAt       DateTime? @map("published_at")

  @@index([status, nextAttemptAt, occurredAt], name: "idx_outbox_polling")
  @@index([aggregateType, aggregateId], name: "idx_outbox_aggregate")
  @@unique([eventType, aggregateId, aggregateRevision], name: "uq_outbox_event_revision")
  @@map("outbox_message")
}

/// Bảng Idempotent Inbox dùng để khử trùng lặp sự kiện nhận được từ các service khác (VD: billing.invoice_paid.v1).
model InboxMessage {
  /// Tên định danh của Consumer tiếp nhận (VD: "contract-invoice-paid-consumer")
  consumerName      String    @map("consumer_name") @db.VarChar(100)

  /// Khóa định danh của sự kiện nhận được (lấy từ OutboxMessage.id của nguồn phát)
  eventId           String    @map("event_id") @db.Uuid

  /// Tên loại sự kiện đã nhận (VD: "billing.invoice_paid.v1")
  eventType         String    @map("event_type") @db.VarChar(100)

  /// Tên dịch vụ nguồn phát sinh (VD: "servicehub.billing")
  producer          String    @db.VarChar(100)

  /// Khóa gom nhóm tuần tự nhận từ nguồn phát
  orderingKey       String?   @map("ordering_key") @db.VarChar(100)

  /// Mã băm SHA-256 của payload nhận được dùng để đối soát chống can thiệp trên đường truyền
  payloadHash       String?   @map("payload_hash") @db.VarChar(64)

  /// Trạng thái xử lý: PROCESSING (đang chạy), PROCESSED (thành công), FAILED (thất bại)
  status            String    @default("PROCESSED") @db.VarChar(20)

  /// Thời điểm Consumer nhận được tin nhắn từ Message Broker
  receivedAt        DateTime  @default(now()) @map("received_at")

  /// Thời điểm Consumer hoàn tất việc cập nhật nghiệp vụ
  processedAt       DateTime? @map("processed_at")

  @@id([consumerName, eventId])
  @@index([orderingKey])
  @@map("inbox_message")
}

/// Bảng API Idempotency Record dùng để chặn trùng lặp Request từ Client hoặc Webhook.
model IdempotencyRecord {
  /// Phạm vi áp dụng của khóa (VD: "CONTRACT_SEND", "CONTRACT_CANCEL")
  scope             String    @db.VarChar(50)

  /// Khóa định danh duy nhất gửi qua Header X-Idempotency-Key
  key               String    @db.VarChar(128)

  /// ID của người dùng thực hiện thao tác
  actorId           String?   @map("actor_id") @db.Uuid

  /// Mã SHA-256 băm toàn bộ Request Body nhằm phát hiện request trùng Key nhưng khác nội dung
  requestHash       String    @map("request_hash") @db.VarChar(64)

  /// Trạng thái: PROCESSING (đang xử lý), COMPLETED (thành công), FAILED (thất bại)
  status            String    @db.VarChar(20)

  /// Bản chụp kết quả phản hồi của lần chạy đầu tiên để trả lại ngay nếu có request gửi trùng
  responseSnapshot  Json?     @map("response_snapshot") @db.JsonB

  /// Thời điểm tạo bản ghi
  createdAt         DateTime  @default(now()) @map("created_at")

  /// Thời điểm hết hạn của bản ghi Idempotency (thường sau 24h)
  expiresAt         DateTime  @map("expires_at")

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}
