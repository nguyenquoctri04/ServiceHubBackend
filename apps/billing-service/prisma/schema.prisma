generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client-billing"
}

datasource db {
  provider = "postgresql"
  url      = env("BILLING_DATABASE_URL")
}

model ServiceUsage {
  id              String       @id @default(uuid()) @db.Uuid
  billingPeriodId String?      @map("billing_period_id") @db.Uuid
  startReadingId  String       @map("start_reading_id") @db.Uuid
  endReadingId    String       @map("end_reading_id") @db.Uuid
  createdAt       DateTime     @map("created_at")
  endReading      MeterReading @relation("UsageEndReading", fields: [endReadingId], references: [id])
  startReading    MeterReading @relation("UsageStartReading", fields: [startReadingId], references: [id])

  @@index([billingPeriodId])
  @@index([startReadingId])
  @@index([endReadingId])
  @@map("service_usage")
}

model Meter {
  id         String         @id @default(uuid()) @db.Uuid
  providerId String         @map("provider_id") @db.Uuid
  serviceId  String         @map("service") @db.Uuid
  name       String
  unit       String
  status     MeterStatus
  createdAt  DateTime       @map("created_at")
  updatedAt  DateTime       @map("updated_at")
  readings   MeterReading[]

  @@index([providerId])
  @@index([serviceId])
  @@map("meter")
}

model MeterReading {
  id          String         @id @default(uuid()) @db.Uuid
  roomId      String?        @map("room_id") @db.Uuid
  contractId  String?        @map("contract_id") @db.Uuid
  meterId     String         @map("meter_id") @db.Uuid
  recordedBy  String         @map("recorded_by") @db.Uuid
  value       Decimal        @db.Decimal(18, 2)
  imgUrl      String?        @map("img_url")
  source      ReadingSource
  status      ReadingStatus  @default(VALID)
  createdAt   DateTime       @map("created_at")
  updatedAt   DateTime       @map("updated_at")
  meter       Meter          @relation(fields: [meterId], references: [id])
  usagesEnd   ServiceUsage[] @relation("UsageEndReading")
  usagesStart ServiceUsage[] @relation("UsageStartReading")

  @@index([meterId, createdAt])
  @@index([roomId])
  @@index([contractId])
  @@index([recordedBy])
  @@map("meter_reading")
}

model Invoice {
  id              String        @id @default(uuid()) @db.Uuid
  invoiceNumber   String        @unique @map("invoice_number")
  customerId      String?       @map("customer_id") @db.Uuid
  contractId      String?       @map("contract_id") @db.Uuid
  billingPeriodId String?       @map("billing_period_id") @db.Uuid
  providerId      String        @map("provider_id") @db.Uuid
  total           Decimal       @db.Decimal(18, 2)
  status          InvoiceStatus
  revision        Int           @default(1)
  createdAt       DateTime      @map("created_at")
  updatedAt       DateTime      @map("updated_at")
  items           InvoiceItem[]
  payments        Payment[]

  @@index([customerId])
  @@index([contractId])
  @@index([billingPeriodId])
  @@index([providerId])
  @@index([providerId, status])
  @@index([status])
  @@map("invoice")
}

model InvoiceItem {
  id             String   @id @default(uuid()) @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  servicePriceId String?  @map("service_price_id") @db.Uuid
  quantity       Decimal  @db.Decimal(18, 2)
  unit           String
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  amount         Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @map("created_at")
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([servicePriceId])
  @@map("invoice_item")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceId     String        @map("invoice_id") @db.Uuid
  paymentMethod PaymentMethod @map("payment_method")
  paymentLinkId String?       @unique @map("payment_link_id")
  status        PaymentStatus
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @map("created_at")
  qrCode        String?       @map("qr_code")
  checkOutUrl   String?       @map("check_out_url")
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payment")
}

enum MeterStatus {
  ACTIVE
  INACTIVE
}

enum ReadingSource {
  MANUAL
  IMAGE
  EXCEL_IMPORT
}

enum ReadingStatus {
  VALID
  VOID
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

// =========================================================================
// RELIABILITY TABLES (Transactional Outbox, Inbox, Idempotency)
// =========================================================================

/// Bảng Transactional Outbox lưu trữ các sự kiện nghiệp vụ phát sinh từ Billing Service (VD: billing.invoice_paid.v1).
/// Đảm bảo nguyên tắc: Mutation nghiệp vụ và Lưu sự kiện nằm trong cùng một Local Transaction.
model OutboxMessage {
  /// Khóa chính định danh duy nhất của sự kiện (UUID v4)
  id                String    @id @default(uuid()) @db.Uuid

  /// Phiên bản của chuẩn CloudEvents (mặc định "1.0")
  specVersion       String    @default("1.0") @map("spec_version") @db.VarChar(10)

  /// Tên loại sự kiện có phân cấp phiên bản (VD: "billing.invoice_paid.v1", "billing.invoice_issued.v1")
  eventType         String    @map("event_type") @db.VarChar(100)

  /// Tên dịch vụ phát sinh sự kiện (mặc định "servicehub.billing")
  source            String    @default("servicehub.billing") @db.VarChar(100)

  /// Khóa định danh của đối tượng chính (thường là invoiceId)
  subject           String    @db.VarChar(100)

  /// Khóa gom nhóm tuần tự (FIFO) nhằm đảm bảo các event của cùng một thực thể (contractId hoặc invoiceId) không bị xử lý lộn xộn
  orderingKey       String    @map("ordering_key") @db.VarChar(100)

  /// Loại đối tượng nghiệp vụ (mặc định "INVOICE")
  aggregateType     String    @default("INVOICE") @map("aggregate_type") @db.VarChar(50)

  /// Khóa chính ID của đối tượng nghiệp vụ (invoiceId)
  aggregateId       String    @map("aggregate_id") @db.Uuid

  /// Phiên bản của hóa đơn tại thời điểm phát sinh sự kiện (phục vụ Optimistic Locking)
  aggregateRevision Int       @default(1) @map("aggregate_revision")

  /// Dữ liệu chi tiết của sự kiện dạng JSONB (chỉ chứa minimal facts, không chứa secret/PII)
  payload           Json      @db.JsonB

  /// Chữ ký HMAC của dòng dữ liệu nhằm chống Insider Threat (Dev/DBA chèn bản ghi giả mạo qua SQL)
  rowSignature      String?   @map("row_signature") @db.VarChar(128)

  /// Trạng thái xử lý: PENDING (chờ phát), PUBLISHED (đã gửi), DEAD_LETTER (lỗi quá 5 lần), TAMPERED (bị sửa trộm)
  status            String    @default("PENDING") @db.VarChar(20)

  /// Số lần đã thử phát lại sự kiện qua Message Broker
  attemptCount      Int       @default(0) @map("attempt_count")

  /// Số lần thử lại tối đa trước khi đưa vào Dead Letter (mặc định 5 lần)
  maxAttempts       Int       @default(5) @map("max_attempts")

  /// Thời điểm kế tiếp cho phép worker quét và thử lại (tính theo Exponential Backoff)
  nextAttemptAt     DateTime  @default(now()) @map("next_attempt_at")

  /// Mã lỗi gần nhất nếu việc phát tin thất bại
  lastErrorCode     String?   @map("last_error_code") @db.VarChar(100)

  /// Chi tiết thông điệp lỗi kỹ thuật để lập trình viên điều tra
  lastErrorMessage  String?   @map("last_error_message") @db.Text

  /// Mã định danh truy vết phân tán xuyên suốt các microservice (Distributed Tracing ID)
  correlationId     String?   @map("correlation_id") @db.Uuid

  /// Thời điểm sự kiện thực tế phát sinh trong nghiệp vụ
  occurredAt        DateTime  @default(now()) @map("occurred_at")

  /// Thời điểm sự kiện đã được chuyển giao thành công sang Message Broker
  publishedAt       DateTime? @map("published_at")

  @@index([status, nextAttemptAt, occurredAt], name: "idx_outbox_polling")
  @@index([aggregateType, aggregateId], name: "idx_outbox_aggregate")
  @@unique([eventType, aggregateId, aggregateRevision], name: "uq_outbox_event_revision")
  @@map("outbox_message")
}

/// Bảng Idempotent Inbox dùng để khử trùng lặp sự kiện nhận được từ các service khác (VD: contract.cancelled.v1, violation.fine_imposed.v1).
model InboxMessage {
  /// Tên định danh của Consumer tiếp nhận (VD: "billing-contract-cancelled-consumer")
  consumerName      String    @map("consumer_name") @db.VarChar(100)

  /// Khóa định danh của sự kiện nhận được (lấy từ OutboxMessage.id của nguồn phát)
  eventId           String    @map("event_id") @db.Uuid

  /// Tên loại sự kiện đã nhận (VD: "contract.cancelled.v1")
  eventType         String    @map("event_type") @db.VarChar(100)

  /// Tên dịch vụ nguồn phát sinh (VD: "servicehub.contract")
  producer          String    @db.VarChar(100)

  /// Khóa gom nhóm tuần tự nhận từ nguồn phát
  orderingKey       String?   @map("ordering_key") @db.VarChar(100)

  /// Mã băm SHA-256 của payload nhận được dùng để đối soát chống can thiệp trên đường truyền
  payloadHash       String?   @map("payload_hash") @db.VarChar(64)

  /// Trạng thái xử lý: PROCESSING (đang chạy), PROCESSED (thành công), FAILED (thất bại)
  status            String    @default("PROCESSED") @db.VarChar(20)

  /// Thời điểm Consumer nhận được tin nhắn từ Message Broker
  receivedAt        DateTime  @default(now()) @map("received_at")

  /// Thời điểm Consumer hoàn tất việc cập nhật nghiệp vụ
  processedAt       DateTime? @map("processed_at")

  @@id([consumerName, eventId])
  @@index([orderingKey])
  @@map("inbox_message")
}

/// Bảng API Idempotency Record dùng để chặn trùng lặp Request từ Client hoặc Webhook (Đặc biệt cho PayOS Webhook).
model IdempotencyRecord {
  /// Phạm vi áp dụng của khóa (VD: "PAYOS_WEBHOOK", "PROVIDER_PAY_INVOICE")
  scope             String    @db.VarChar(50)

  /// Khóa định danh duy nhất gửi qua Header X-Idempotency-Key hoặc mã paymentLinkId từ cổng thanh toán
  key               String    @db.VarChar(128)

  /// ID của người dùng thực hiện thao tác
  actorId           String?   @map("actor_id") @db.Uuid

  /// Mã SHA-256 băm toàn bộ Request Body nhằm phát hiện request trùng Key nhưng khác nội dung
  requestHash       String    @map("request_hash") @db.VarChar(64)

  /// Trạng thái: PROCESSING (đang xử lý), COMPLETED (thành công), FAILED (thất bại)
  status            String    @db.VarChar(20)

  /// Bản chụp kết quả phản hồi của lần chạy đầu tiên để trả lại ngay nếu có request gửi trùng
  responseSnapshot  Json?     @map("response_snapshot") @db.JsonB

  /// Thời điểm tạo bản ghi
  createdAt         DateTime  @default(now()) @map("created_at")

  /// Thời điểm hết hạn của bản ghi Idempotency (thường sau 24h)
  expiresAt         DateTime  @map("expires_at")

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_record")
}
